# Copy to .env and fill in. Never commit the real .env.

# Required: Portkey gateway credential for the model.
PORTKEY_API_KEY=your_portkey_api_key_here

# Signs session tokens. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Falls back to an insecure dev value if unset. MUST be set in production.
JWT_SECRET=

# Optional. Unset = bundled SQLite file. In production use the Supabase
# connection string, e.g. postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=

# Optional. Comma-separated CORS origins. Defaults to * for local development.
# In production set this to your Render static site URL.
ALLOWED_ORIGINS=
